DATABASE_URL="file:./dev.db"

# Public origin of the site. Used for canonical URLs, sitemap.xml, robots.txt
# and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login (used by prisma/seed.ts to create the admin account)
ADMIN_EMAIL="admin@originlife.co"
ADMIN_PASSWORD="ChangeMe123!"

# Secret used to sign admin session cookies — change this in production
AUTH_SECRET="dev-only-secret-change-me-1234567890"

# Razorpay TEST mode keys — get these from https://dashboard.razorpay.com/app/keys (Test Mode)
# Leave blank to keep checkout in demo mode (orders are recorded but payment is simulated)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
