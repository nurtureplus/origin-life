generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Customer {
  id           String            @id @default(cuid())
  email        String            @unique
  phone        String            @unique
  passwordHash String
  name         String
  /// Denormalised cache of unexpired coins. The lots in `coinLots` are the
  /// source of truth — this is kept in step for cheap reads.
  lifeCoins    Int               @default(0)
  createdAt    DateTime          @default(now())
  orders       Order[]
  coinLedger   CoinTransaction[]
  coinLots     CoinLot[]
  reviews      Review[]
}

/// A batch of coins credited by one order, with its own 60-day expiry.
/// Coins are spent soonest-expiring-first so customers lose as few as possible.
model CoinLot {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  /// The delivered order that earned these coins. Unique so delivery can be
  /// processed twice without granting twice.
  orderId    String?  @unique
  amount     Int
  remaining  Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId, expiresAt])
}

// Append-only ledger of every Life Coin movement.
// `amount` is signed: positive credits, negative debits.
model CoinTransaction {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  orderId      String?
  type         String // earned | redeemed | earn_reversed | redeem_refunded | adjustment
  amount       Int
  balanceAfter Int
  note         String?
  createdAt    DateTime @default(now())

  // One row per (order, type) keeps awarding/reversal idempotent under retries.
  @@unique([orderId, type])
  @@index([customerId, createdAt])
}

/// Single-use, expiring password reset tokens.
/// Only a SHA-256 hash of the token is stored, so a database leak can't be
/// used to reset anyone's password.
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  /// Exactly one of these is set — resets work for customers and admins.
  customerId String?
  adminId    String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([adminId])
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  tagline     String
  description String
  benefits    String // JSON-encoded string[]
  ingredients String // JSON-encoded string[]
  priceCents  Int
  compareAtCents Int?
  category    String
  badge       String?
  image       String
  stock       Int         @default(100)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)

  // --- Label / compliance block ---------------------------------------------
  // Nutraceuticals sold in India carry mandatory label information (FSSAI), and
  // the product page has to be able to show it. Every field is optional so
  // existing rows stay valid, but the page renders the section either way —
  // a missing value shows as "Not provided" rather than silently vanishing,
  // which is what stops a half-filled product going live unnoticed.
  servingSize     String?
  servingsPerPack Int?
  /// JSON-encoded { label: string; amount: string }[] — the nutrition table.
  nutritionFacts  String?
  directions      String?
  warnings        String?
  allergens       String?
  storage         String?
  manufacturer    String?
  fssaiLicense    String?
  countryOfOrigin String?
  shelfLifeMonths Int?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

/// A customer review. One per customer per product — a second submission edits
/// the first rather than stacking, which is the cheapest defence against a
/// single account flooding a product with five-star entries.
model Review {
  id               String   @id @default(cuid())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String
  /// Denormalised so a deleted account's review still shows an author.
  authorName       String
  rating           Int
  title            String?
  comment          String
  /// True when the reviewer has a delivered order containing this product.
  /// Set server-side from the order history — never from the request body.
  verifiedPurchase Boolean  @default(false)
  /// pending | approved | rejected. Only `approved` is public.
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model Order {
  id                String      @id @default(cuid())
  status            String      @default("pending") // pending | paid | shipped | delivered | cancelled
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerId        String?
  customerName      String
  customerEmail     String
  customerPhone     String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  subtotalCents     Int
  shippingCents     Int         @default(0)
  coinsRedeemed     Int         @default(0)
  discountCents     Int         @default(0)
  totalCents        Int
  coinsEarned       Int         @default(0)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  name       String
  priceCents Int
  quantity   Int
}

model Promo {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  image     String
  badge     String?
  ctaLabel  String?
  ctaHref   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  // Body text. Blank lines separate paragraphs; a line starting with "## "
  // renders as a subheading.
  content     String
  coverImage  String
  category    String // New Supplements | Health Insights | Brand
  author      String   @default("OriginLife")
  readMinutes Int      @default(4)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model Reel {
  id           String   @id @default(cuid())
  title        String
  videoUrl     String
  thumbnail    String?
  instagramUrl String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
